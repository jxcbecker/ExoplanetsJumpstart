threshold = 6250
hot_stars = final_merged_df.loc[(final_merged_df['Teff'] > threshold) & (final_merged_df['lambda'] != -999)]
cool_stars = final_merged_df.loc[(final_merged_df['Teff'] <= threshold) & (final_merged_df['lambda'] != -999)]

plt.figure(figsize=(8,5))
plt.hist(cool_stars['lambda'], bins=20, alpha=0.7, density = True, label=r'Cool stars (Teff <= %i K)' % threshold)
plt.hist(hot_stars['lambda'], bins=20, alpha=0.7, density = True, label="Hot stars (Teff > %i K)" % threshold)

plt.xlabel("Obliquity (deg)", fontsize=15)
plt.ylabel("Number of systems", fontsize=15)
plt.legend(fontsize=12)
plt.xticks(fontsize=12)
plt.yticks(fontsize=12)



from scipy.stats import ks_2samp

hot_vals = hot_stars['lambda'].values
cool_vals = cool_stars['lambda'].values
ks_stat, p_value = ks_2samp(hot_vals, cool_vals) # this doesn't work if you haven't normalized distributions in the same way. it doesn't know 360 deg = 0 deg

print(p_value)


# or check the singles and multis: 
